# Copy this file to .env (gitignored) to configure your local dev.sh run —
# see the comment at the top of saas/dev.sh for how it's loaded.

# Set to 1 to run real pentests via the strix engine (Docker + LLM
# credentials required) instead of the mock scanner. Requires the
# `real-scan` dependency extra, which dev.sh installs automatically when
# this is set to 1 — you don't need to run `uv sync --extra real-scan`
# yourself.
SAAS_ENABLE_REAL_SCAN=1

# On macOS with Docker Desktop, the Docker Python SDK's default socket
# path (/var/run/docker.sock) is usually wrong. Find the real one with:
#   docker context inspect | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["Endpoints"]["docker"]["Host"])'
# and paste it here. Leave unset if you're not on macOS/Docker Desktop.
DOCKER_HOST=unix:///Users/YOUR_USERNAME/.docker/run/docker.sock

# Strix sends small, anonymous product-analytics events (PostHog + scarf.sh)
# during a scan by default. If your network can't reach those endpoints
# (corporate firewall/VPN), each blocked call times out after a couple of
# seconds and logs a caught-but-noisy traceback in strix.log — harmless,
# but uncomment this to silence it and skip the wasted time:
# STRIX_TELEMETRY=0
